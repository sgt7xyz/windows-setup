# ---------------------------------------------------------------
# File:     .gitignore
# Purpose:  Keep secrets, state files, and build artifacts out of version control
# Project:  project-standards-kit
# Author:   SGT7 LLC
# ---------------------------------------------------------------

# SECURITY: Environment files hold real secrets. Only the fake example file is committed.
.env
.env.*
!.env.example

# SECURITY: Keys and certificates must never be committed.
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
id_rsa*
id_ed25519*

# SECURITY: Terraform state can contain secrets in plain text.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraform/
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# NOTE: Variable files may hold secrets. Commit only the .example copies.
*.tfvars
*.tfvars.json
!*.tfvars.example
# NOTE: The lock file is intentionally committed to pin provider versions.

# SECURITY: Cloud and tool credentials.
.aws/
credentials
*.secret
*.secrets
secrets.*
!secrets.example.*
.vault-pass*
*.vault

# NOTE: new-project.sh --existing merges only the lines above this marker into older projects.
# Everything below this line is operating system, editor, and language tooling, not secrets.

# Operating system files

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

# Editors and AI tools
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude/
claude_history/
.chatgpt/
.openai/
chatgpt_history.json
.gpt-pilot/
.gemini/
.vertexai/
.perplexity/
perplexity_results/
.llm/
.ai_history/
.cursor/
.aider*
.continuation/
.idx/
.chroma/
.pinecone/
.faiss/

# Logs and local data
logs/
*.log
fonttmp/
*.sqlite
*.sqlite3

# Ansible and Packer
*.retry
packer_cache/
*.auto.pkrvars.hcl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
.turbo/
coverage/
npm-debug.log*
.eslintcache

# Windows development
*.code-workspace
.vs/
*.suo
*.user
*.sln.iml

# PowerShell
PSScriptAnalyzerSettings.psd1
